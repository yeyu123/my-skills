# ThinkPHP 多应用 Starter 环境变量示例
# 使用方式：复制为项目根目录的 .env，再按实际环境填写。
# 注意：.env 不要提交到版本控制；真实密钥不要写入代码库。

# 应用
APP_DEBUG = true
APP_TRACE = false

# 数据库（对应 config/database.php）
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = root
DB_PASS =
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX =

# Redis（对应 app/<应用名>/config/redis.php）
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_DB = 0
REDIS_TIMEOUT = 2.0
REDIS_PREFIX = tp:

# JWT（对应 config/app.php 的 jwt 节点）
JWT_SECRET =
